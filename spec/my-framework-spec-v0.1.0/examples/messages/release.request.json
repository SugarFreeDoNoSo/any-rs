{
  "release_id": "release_001",
  "expected_registry_revision": 0,
  "documents": [
    {
      "api_version": "framework/v1alpha1",
      "kind": "ValueObject",
      "id": "core.display_name",
      "version": 1,
      "immutable": true,
      "fields": {
        "text": {
          "type": "string",
          "required": true,
          "nullable": false,
          "min_length": 1,
          "max_length": 120
        }
      }
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "ValueObject",
      "id": "sales.money",
      "version": 1,
      "immutable": true,
      "fields": {
        "amount": {
          "type": "string",
          "format": "decimal",
          "required": true,
          "nullable": false,
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "currency": {
          "type": "string",
          "required": true,
          "nullable": false,
          "one_of": [
            "CLP",
            "USD",
            "EUR"
          ]
        }
      }
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Entity",
      "id": "sales.customer",
      "version": 1,
      "fields": {
        "name": {
          "type": "reference",
          "target": "core.display_name",
          "required": true,
          "nullable": false
        }
      }
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Entity",
      "id": "sales.order",
      "version": 1,
      "fields": {
        "total": {
          "type": "reference",
          "target": "sales.money",
          "required": true,
          "nullable": false
        }
      }
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Relation",
      "id": "sales.customer_order",
      "version": 1,
      "unique_pair": true,
      "on_delete": "restrict",
      "left": {
        "target": "sales.customer",
        "cardinality": {
          "min": 0
        }
      },
      "right": {
        "target": "sales.order",
        "cardinality": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Event",
      "id": "core.object_created",
      "version": 1,
      "message_type": "dev.framework.object.created.v1",
      "data_schema": "ObjectCreatedData",
      "retention_days": 30,
      "replay_safe": true
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Command",
      "id": "core.create_object",
      "version": 1,
      "message_name": "core.object.create",
      "owner": "core.create_object_handler",
      "input_schema": "CreateObjectPayload",
      "required_action": "object.create",
      "emits": [
        "dev.framework.object.created.v1"
      ]
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Handler",
      "id": "core.create_object_handler",
      "version": 1,
      "runtime_entrypoint": "core.handlers.create_object",
      "artifact_version": "reference-0.1.0",
      "consumes": [
        "core.object.create"
      ],
      "emits": [
        "dev.framework.object.created.v1"
      ],
      "required_profile": "durable_async",
      "service_principal": "service_core"
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Handler",
      "id": "sales.orders_projector",
      "version": 1,
      "runtime_entrypoint": "sales.projectors.orders",
      "artifact_version": "reference-0.1.0",
      "consumes": [
        "dev.framework.object.created.v1"
      ],
      "emits": [],
      "required_profile": "durable_async",
      "service_principal": "service_projection"
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Subscription",
      "id": "sales.orders_projection",
      "version": 1,
      "message_types": [
        "dev.framework.object.created.v1"
      ],
      "handler": "sales.orders_projector",
      "delivery": "at_least_once",
      "max_attempts": 8,
      "lease_ms": 30000,
      "ordered_by": "aggregate"
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Profile",
      "id": "client_editor",
      "version": 1,
      "assignment_scope": "client",
      "permissions": [
        "object.create",
        "object.read",
        "object.update",
        "object.query",
        "view.render"
      ]
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "Policy",
      "id": "client_access",
      "version": 1,
      "default_effect": "deny",
      "rules": [
        {
          "effect": "allow",
          "actions": [
            "object.create",
            "object.read",
            "object.update",
            "object.query",
            "view.render"
          ],
          "subject_profiles": [
            "client_editor"
          ],
          "resource_types": [
            "core.display_name",
            "sales.money",
            "sales.customer",
            "sales.order",
            "sales.orders"
          ],
          "condition": {
            "op": "same_scope"
          }
        },
        {
          "effect": "deny",
          "actions": [
            "object.delete"
          ],
          "subject_profiles": [
            "client_editor"
          ],
          "condition": {
            "op": "same_scope"
          }
        }
      ]
    },
    {
      "api_version": "framework/v1alpha1",
      "kind": "View",
      "id": "sales.orders",
      "version": 1,
      "renderer": "html-htmx",
      "template": "templates/orders.html",
      "editable_paths": [
        "/draft/money_id"
      ],
      "query": {
        "type": "sales.order",
        "select": [
          "id",
          "total.amount",
          "total.currency"
        ],
        "source": "authoritative"
      },
      "actions": {
        "submit": "core.object.create"
      }
    }
  ]
}
