{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:any-rs:machine-ir:1",
  "title": "any-rs neutral Machine IR v1",
  "description": "Reviewable structural schema for the closed executable FSM vocabulary. Passing JSON Schema is necessary but not sufficient: Rust CompiledMachine is authoritative for semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "collection",
    "initial_state",
    "states",
    "terminal_states",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/Identifier"
    },
    "collection": {
      "$ref": "#/$defs/Identifier"
    },
    "initial_state": {
      "$ref": "#/$defs/Identifier"
    },
    "creation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Creation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Missing or null maps to Rust Option::None. Serialization omits None."
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "state_labels": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/Identifier"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
        "not": {
          "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
        }
      },
      "description": "Display-only labels. Rust also requires keys to name declared states and label UTF-8 bytes <=128. JSON Schema maxLength counts characters, not bytes."
    },
    "terminal_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9_.:\\-]"
      }
    },
    "CreationAction": {
      "oneOf": [
        {
          "$ref": "#/$defs/CreateObject"
        },
        {
          "$ref": "#/$defs/EmitEvent"
        }
      ]
    },
    "CreateObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "create_object"
        },
        "object_type": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "object_type"
      ]
    },
    "EmitEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "emit_event"
        },
        "event_name": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "event_name"
      ]
    },
    "SetState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_state"
        },
        "state": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "state"
      ]
    },
    "Action": {
      "oneOf": [
        {
          "$ref": "#/$defs/CreateObject"
        },
        {
          "$ref": "#/$defs/EmitEvent"
        },
        {
          "$ref": "#/$defs/SetState"
        }
      ]
    },
    "Guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "valid_identifier"
            },
            "field": {
              "const": "input.id"
            }
          },
          "required": [
            "kind",
            "field"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "string_length"
            },
            "field": {
              "const": "input.text"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          },
          "required": [
            "kind",
            "field",
            "min",
            "max"
          ],
          "description": "UTF-8 byte length bounds, inclusive. Rust additionally requires min <= max."
        }
      ]
    },
    "Creation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/Identifier"
        },
        "initial_state": {
          "$ref": "#/$defs/Identifier"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CreationAction"
          },
          "contains": {
            "$ref": "#/$defs/CreateObject"
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": [
        "event",
        "initial_state",
        "actions"
      ],
      "description": "Initialization descriptor, not a state-transition edge. Rust additionally checks collection, initial state, and event disambiguation."
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/Identifier"
        },
        "event": {
          "$ref": "#/$defs/Identifier"
        },
        "to": {
          "$ref": "#/$defs/Identifier"
        },
        "guards": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Guard"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Action"
          },
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/CreateObject"
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/SetState"
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        }
      },
      "required": [
        "from",
        "event",
        "to",
        "guards",
        "actions"
      ]
    }
  },
  "$comment": "Rust separately enforces source <=1 MiB, identifier semantics, references to declared states, terminal-source rejection, unique (from,event), creation event disjointness, initial-state equality, collection/type equality, set_state target equality, UTF-8 byte limits and numeric min<=max. No executable language callbacks exist."
}
